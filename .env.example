# Пример переменных окружения «Қайда?». Скопируйте в .env и впишите свои значения.
# Настоящие ключи в репозиторий не коммитьте: .env в .gitignore. В облаке — секреты
# GitHub Actions / Supabase secrets / переменные окружения хостинга.

# ---------------------------------------------------------------- Supabase (db/)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
# только для бэкенда (Edge Function demo-login) и сидов — никогда во фронт
SUPABASE_SERVICE_ROLE_KEY=
# для db/scripts/apply_local.sh и export_mocks.sh
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# ---------------------------------------------------------------- Edge Function api
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_KEY=change-me
AI_TIMEOUT_MS=8000
# тестовый вход по роли без пароля (раздел 2); в продакшене — false
DEMO_MODE=true
DEMO_PASSWORD=change-me-demo-password

# ---------------------------------------------------------------- ИИ-сервис (ai/)
MODEL_PATH=ai/models/model.onnx
# URL модели из GitHub Release (workflow «AI · модель»)
MODEL_URL=
MODEL_VERSION=
CLASS_MAP=auto
CONF_THRESHOLD=0.35
IOU_THRESHOLD=0.45
# тот же ключ, что AI_SERVICE_KEY у Edge Function
AI_API_KEY=change-me
RATE_LIMIT_PER_MIN=30
MAX_CONCURRENCY=2
# журнал ошибок в общую таблицу app_logs: <SUPABASE_URL>/rest/v1/rpc/log_event + anon key
LOG_URL=
LOG_KEY=

# ---------------------------------------------------------------- web/
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=https://your-project-ref.supabase.co/functions/v1/api
NEXT_PUBLIC_DEMO_MODE=true
