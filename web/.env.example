# Supabase (публичные ключи; секреты — только на сервере)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Базовый URL REST-API (если пусто — работают моки из src/mocks)
NEXT_PUBLIC_API_URL=
# Принудительно включить моки, даже если API задан
NEXT_PUBLIC_USE_MOCKS=true
# Публичный сервер маршрутизации OSRM (для треков по дорогам)
NEXT_PUBLIC_OSRM_URL=https://router.project-osrm.org
# Стиль карты (векторные тайлы OSM). Светлая / тёмная темы
NEXT_PUBLIC_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_STYLE_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
